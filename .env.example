# Copy this file to .env and fill it in. .env is gitignored; never commit real keys.

# Gemini API key, free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# PayPal sandbox app: https://developer.paypal.com/dashboard (Apps & Credentials, Sandbox tab)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=USD
